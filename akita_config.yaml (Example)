# akita_config.yaml - Configuration for Akita DDNS

# --- Core Settings ---

# Path for Reticulum storage (identities, transport data, etc.)
# Default: ~/.config/reticulum
storage_path: "~/.config/reticulum"

# IMPORTANT: The Identity hash defining THIS Akita DDNS network.
# All nodes participating in the *same* DDNS must use the *same* hash.
# Generate and retain the authority using:
# python -c "import RNS as r; i=r.Identity(); i.to_file('akita-network-authority'); print(i.hash.hex())"
# If null, this node's persisted identity hash is used. Multi-node deployments must
# set the same generated hash on every participating node.
akita_namespace_identity_hash: null

# --- Timing Settings (seconds) ---

# Default time-to-live for registrations if not specified by the client.
default_ttl: 86400 # 1 day
max_registration_ttl: 604800 # 7 days
max_clock_skew: 300

# Base interval for gossiping registry information. Jitter is added automatically.
gossip_interval: 120 # 2 minutes
peer_ttl: 900
max_gossip_entries_per_cycle: 100

# How often the node checks its local registry for expired entries.
ttl_check_interval: 60

# How long resolved names stay in the local cache.
cache_ttl: 300 # 5 minutes

# --- Performance & Limits ---

# Global in-memory and registry limits.
max_cache_size: 1000
max_registry_size: 10000
max_namespaces: 1000

# Safe default: registrations are accepted only in a claimed namespace.
allow_unowned_namespaces: false

# Max incoming requests per second (token bucket rate) before dropping packets.
rate_limit_requests_per_sec: 10.0

# --- Logging ---

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
log_level: "INFO"

# --- Persistence Settings ---

# Whether to save/load registry, namespaces, reputation to files.
persist_state: true

# Directory to store persistent state files.
persistence_path: "./akita_state"
max_state_file_bytes: 16777216

# Filenames for persistence within persistence_path.
namespace_owners_file: "namespaces.yaml"
registry_file: "registry.yaml"
reputation_file: "reputation.yaml"

# --- Web UI Settings ---
web_ui_enabled: true
web_ui_host: "127.0.0.1"
web_ui_port: 48080

# State-changing API calls are disabled unless explicitly enabled with a bearer token.
web_ui_allow_mutations: false
# Prefer the AKITA_WEB_UI_API_TOKEN environment variable when enabling mutations.
web_ui_api_token: null
web_ui_max_request_bytes: 16384
